From b68c0fa3dab6d014ff9d9a8a973933e0993aef66 Mon Sep 17 00:00:00 2001
From: development <pmsfriend@googlemail.com>
Date: Wed, 18 Nov 2026 23:41:29 +0100
Subject: [PATCH 1/2] CI: the new :core module in the path filters of unit.yml
 and web.yml; lint fails on a new error-level finding
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Rebuild phase 1 moves Android-free packages to core/: a push that touches only core/** must start the unit run and the
planner run (path filters, the planner's engine cache key, the unit report). Lint (owner 2026-11-18, „einfach
einschalten“, donald's proposal as written): abortOnError = true, continue-on-error out of unit.yml; the baseline
(app/lint-baseline.xml) stays, so only new findings fail.

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>
---
 .github/workflows/unit.yml | 10 +++++-----
 .github/workflows/web.yml  |  4 +++-
 app/build.gradle.kts       |  2 +-
 3 files changed, 9 insertions(+), 7 deletions(-)

diff --git a/.github/workflows/unit.yml b/.github/workflows/unit.yml
index 6d181ed91..ae74e6669 100644
--- a/.github/workflows/unit.yml
+++ b/.github/workflows/unit.yml
@@ -6,8 +6,8 @@
 # app/src/test/snapshots/images/ (verifyPaparazziDebug runs the same test task in verify mode, so the suite runs once).
 # A changed screen = record locally (./gradlew :app:recordPaparazziDebug), look at the images, commit them.
 #
-# Lint: its own job, reports only (owner: not failing the build at first). Known findings are in app/lint-baseline.xml,
-# so the report and the job summary list only NEW issues.
+# Lint: its own job; a NEW finding of severity error fails it (owner 2026-11-18: „einfach einschalten“). Known findings
+# are in app/lint-baseline.xml, so the report and the job summary list only new issues.
 #
 # Actions pinned to a commit (# = its release), like maps-deploy.yml.
 name: Unit tests
@@ -17,6 +17,7 @@ on:
     branches: [main]
     paths:
       - "app/**"
+      - "core/**"
       - "strings/**"
       - "tools/ci/**"
       - "*.gradle.kts"
@@ -53,6 +54,7 @@ jobs:
           name: unit-report
           path: |
             app/build/reports/tests/
+            core/build/reports/tests/
             app/build/paparazzi/failures/
           if-no-files-found: ignore
           retention-days: 7
@@ -70,10 +72,8 @@ jobs:
         with:
           packages: "platforms;android-36 build-tools;35.0.0 platform-tools"
       - uses: gradle/actions/setup-gradle@0723195856401067f7a2779048b490ace7a47d7c # v5.0.2
-      # abortOnError = false (app/build.gradle.kts): findings never fail this step; continue-on-error keeps a lint
-      # crash from turning the run red while lint only reports
+      # abortOnError = true (app/build.gradle.kts): a new error-level finding fails this step
       - name: Android lint (new findings only – the rest is in app/lint-baseline.xml)
-        continue-on-error: true
         run: ./gradlew --no-daemon :app:lintDebug
       - name: Lint summary
         if: always()
diff --git a/.github/workflows/web.yml b/.github/workflows/web.yml
index 355ca4f45..24e37004d 100644
--- a/.github/workflows/web.yml
+++ b/.github/workflows/web.yml
@@ -21,6 +21,7 @@ on:
       - "app/web-shared-files.txt"
       - "app/src/main/java/**"
       - "app/src/test/java/com/onpath/app/**"
+      - "core/**"
       - "app/libs/**"
       - "app/src/main/assets/**"
       - "tools/routing/jvm-test/stubs/**"
@@ -38,6 +39,7 @@ on:
       - "app/web-shared-files.txt"
       - "app/src/main/java/**"
       - "app/src/test/java/com/onpath/app/**"
+      - "core/**"
       - "app/libs/**"
       - "app/src/main/assets/**"
       - "tools/routing/jvm-test/stubs/**"
@@ -103,7 +105,7 @@ jobs:
           path: |
             web/engine/build/generated/teavm/wasm-gc
             web/engine/build/style
-          key: web-engine-v1-${{ runner.os }}-${{ hashFiles('web/engine/**', 'app/src/main/java/**', 'app/src/test/java/com/onpath/app/**', 'app/libs/**', 'app/src/main/assets/**', 'tools/routing/jvm-test/stubs/**', 'strings/**', 'web/strings/**', 'gradle/**', 'gradlew', 'gradle.properties', 'settings.gradle.kts', 'build.gradle.kts', '.github/workflows/web.yml') }}
+          key: web-engine-v1-${{ runner.os }}-${{ hashFiles('web/engine/**', 'app/src/main/java/**', 'app/src/test/java/com/onpath/app/**', 'core/**', 'app/libs/**', 'app/src/main/assets/**', 'tools/routing/jvm-test/stubs/**', 'strings/**', 'web/strings/**', 'gradle/**', 'gradlew', 'gradle.properties', 'settings.gradle.kts', 'build.gradle.kts', '.github/workflows/web.yml') }}
 
       - uses: actions/setup-java@v4
         if: steps.engine.outputs.cache-hit != 'true'
diff --git a/app/build.gradle.kts b/app/build.gradle.kts
index 9836d55d1..6afa59a50 100644
--- a/app/build.gradle.kts
+++ b/app/build.gradle.kts
@@ -142,7 +142,7 @@ android {
         sourceSets["main"].assets.srcDir(overviewAssets)
     }
     lint {
-        abortOnError = false
+        abortOnError = true // a new error-level finding fails the lint job (owner 2026-11-18); known ones are in the baseline
         checkReleaseBuilds = false
         // Known findings live in the baseline: only new ones are reported (CI job "lint" in unit.yml).
         // Refresh after fixing some: delete the file, run ./gradlew :app:lintDebug once (it writes a new one).
-- 
2.53.0


